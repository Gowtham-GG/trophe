# Same Supabase project as Argus and Mneme (Dashboard -> Settings -> API).
# Only the public anon key belongs here. NEVER put the service_role key in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (used by the Vercel function api/food-search.ts, never sent to the browser).
# Free key: https://api.data.gov/signup/ — without it, the shared DEMO_KEY allows ~10 USDA searches an hour.
USDA_API_KEY=
